{
  "name": "genesis-magma-f1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder",
    "desktop:win": "vite build && electron-builder --win",
    "desktop:mac": "vite build && electron-builder --mac",
    "desktop:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "main": "electron/main.cjs",
  "description": "Genesis Magma F1 Team — jeu de gestion F1",
  "author": "Liam Robert",
  "build": {
    "appId": "com.genesis.magmaf1",
    "productName": "Genesis Magma F1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Genesis Magma F1"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game",
      "syncDesktopName": true
    }
  },
  "desktopName": "genesis-magma-f1.desktop"
}
